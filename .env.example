# ---------------------------------------------------------------------------
# LoopGuru — environment template. Copy to .env and fill in.
# NEVER put real secrets here — this file is committed. Real values go in .env.
# ---------------------------------------------------------------------------

# --- LLM / vector ---
OPENAI_API_KEY=sk-...
# Leave OPENAI_BASE_URL empty for public OpenAI; set to your Azure OpenAI endpoint to swap.
OPENAI_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4o-mini
VISION_MODEL=gpt-4o-mini
ENABLE_VISION=true
MAX_IMAGE_PAGES=8
OPENAI_TIMEOUT_S=60
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=knowledge
QDRANT_COLLECTION_VERSION=1

# --- infra ---
DATABASE_URL=postgresql+psycopg2://loopguru:loopguru@postgres:5432/loopguru
CELERY_BROKER_URL=amqp://guest:guest@rabbitmq:5672//

# --- slack ---
SLACK_BOT_TOKEN=xoxb-...
# For the @mention bot (Events API): from Slack app → Basic Information → Signing Secret
SLACK_SIGNING_SECRET=
# App-level token (xapp-…) for Socket Mode (no public URL needed). Needs connections:write.
SLACK_APP_TOKEN=
SLACK_BOT_USER_ID=
# Optional; auto-derived from auth.test when empty.
SLACK_WORKSPACE_SUBDOMAIN=
# JSON list of channel IDs to index, e.g. ["C0123ABCD","C0456WXYZ"]
SLACK_CHANNELS=[]
# Optional JSON list of channel IDs, ordered for backfill priority.
SLACK_CHANNEL_PRIORITY=[]
# Optional JSON list of bot user IDs whose messages should be kept.
USEFUL_BOT_IDS=[]
# Set true only if you want the bot to auto-join public channels (needs channels:join).
SLACK_AUTO_JOIN=false

# --- rag ---
RAG_TOP_K=8
RAG_OVERFETCH_K=20
RAG_RELEVANCE_FLOOR=0.35
RAG_DEDUP_SIM=0.97
RAG_RECENCY_HALFLIFE_DAYS=180
RAG_EXPAND_MAX_CHUNKS=24
RAG_CONTEXT_TOKEN_BUDGET=12000
RAG_HYBRID=true
RAG_RRF_K=60

# --- ingestion ---
SYNC_OVERLAP_DAYS=2
REPLY_POLL_BATCH=50
EMBED_BATCH_SIZE=128
MAX_FILE_BYTES=26214400
MAX_QUESTION_CHARS=4000
CHUNK_TARGET_TOKENS=650
CHUNK_OVERLAP_RATIO=0.12
CHUNK_MAX_TOKENS=8000

# --- azure devops (boards) --- (optional; for the ticket-creation feature)
AZURE_DEVOPS_ORG=
AZURE_DEVOPS_PROJECT=
AZURE_DEVOPS_PAT=
AZURE_DEVOPS_WORKITEM_TYPE=Task
AZURE_DEVOPS_ASSIGNED_TO=

# --- api / ops ---
API_KEY=change-me-to-a-long-random-secret
API_RATE_LIMIT=60/minute
MAX_REQUEST_BYTES=65536
ALERT_WEBHOOK_URL=
STALE_SCOPE_ALERT_DAYS=3

# --- misc ---
LOG_LEVEL=INFO
